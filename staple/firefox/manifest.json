{
  "manifest_version": 2,
  "name": "Staple",
  "version": "1.0",
  "description": "AI that walks you through any UI",
  "icons": { "16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png" },
  "permissions": ["activeTab", "storage", "tabs", "<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "background": { "scripts": ["background.js"], "persistent": false },
  "browser_action": { "default_popup": "popup.html", "default_icon": { "16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png" } },
  "browser_specific_settings": {
    "gecko": { "id": "staple@hack", "strict_min_version": "109.0" }
  },
  "commands": {
    "toggle-staple": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Open Staple search"
    }
  }
}
